# Format: <SettingName>: <Settingvalue>
# Setting name must appear at start of line and there must be whitespace after the colon.

# --- raddbg Core UI & Panels (Grey scale) ---
UI.UI:                                            20, 20, 20
UI.UI Text:                                       210, 210, 210
UI.UI Selected Text:                              255, 255, 255
UI.UI Selected Item:                              50, 50, 50
UI.Menu:                                          20, 20, 20
UI.Menu (highlighted):                            40, 40, 40
UI.Menu (selected):                               40, 40, 40
UI.App Border (active):                           60, 60, 60
UI.App Border (inactive):                         20, 20, 20
UI.Panels.Active Tab:                             40, 40, 40
UI.Panels.Active Tab Text:                        210, 210, 210
UI.Panels.Inactive Tab Text:                      110, 110, 110
UI.Panels.Inactive Tab:                           20, 20, 20
UI.Panels.Scrollbar Background:                   20, 20, 20
UI.Panels.Scrollbar Bar:                          60, 60, 60
UI.Panels.Scrollbar Bar (hover):                  90, 90, 90
UI.Panels.Scrollbar Bar (drag):                   130, 130, 130
UI.Panels.MapScrollbar Bar:                       default

# --- Trees & Lists ---
UI.SearchHighlight:                               210, 150, 70
UI.WorkspaceTreeNode:                             default
UI.ActiveWorkspaceTreeNode:                       50, 50, 50
UI.WorkspaceTreeNodeBorder:                       0, 0, 0
UI.ActiveWorkspaceTreeNodeBorder:                 default
UI.SourceFileTreeNode:                            210, 210, 210
UI.HeaderFileTreeNode:                            210, 210, 210
UI.MiscFileTreeNode:                              110, 110, 110
UI.FolderTreeNode:                                210, 210, 210
UI.SelectedSearchResultLine:                      40, 40, 40
TreeNodeText:                                     210, 210, 210

# --- Editor Core ---
Editor.Text:                                      210, 210, 210
Editor.Background:                                20, 20, 20
Editor.Cursor:                                    210, 150, 70
Editor.Current Line:                              30, 30, 30
Editor.Selection Back:                            60, 60, 60
Editor.Selection Fore:                            default
Editor.Find.Text Highlight:                       210, 150, 70
Editor.Find.Bracket Highlight:                    190, 110, 150
Editor.Rename Symbol Back:                        60, 60, 60
Editor.Rename Symbol Fore:                        255, 255, 255
Editor.Line Numbers:                              90, 90, 90
Editor.Margin:                                    20, 20, 20
Editor.SymbolHighlight:                           60, 60, 60
Editor.WordHighlight:                             default
Editor.Whitespace:                                50, 50, 50
Editor.LineEndings:                               50, 50, 50
Editor.IndentLine:                                40, 40, 40
Editor.VerticalRulers:                            40, 40, 40

# --- Syntax Highlighting (Strict 4-Color raddbg Mapping) ---
Language.Text:                                    210, 210, 210
Language.Background:                              20, 20, 20

# Dark Pink (Keywords, Control Flow, Numbers)
Language.Keyword:                                 190, 110, 150
Language.ControlFlowKeyword:                      190, 110, 150
Language.NewDeleteKeyword:                        190, 110, 150
Language.UsingKeyword:                            190, 110, 150
Language.LiteralKeyword:                          190, 110, 150
Language.Number:                                  190, 110, 150
Language.Enum Value:                              190, 110, 150

# Burnt Yellow (Types, Classes, Functions)
Language.Type:                                    210, 150, 70
Language.Class:                                   210, 150, 70
Language.Enum:                                    210, 150, 70
Language.Typedef:                                 210, 150, 70
Language.Function:                                210, 150, 70
Language.MemberFunction:                          210, 150, 70

# Green (Strings, Preprocessor)
Language.String:                                  140, 190, 140
Language.Preprocessor:                            140, 190, 140
UI.UpdatedLine:                                   140, 190, 140

# Grey (Comments, Variables, Punctuation, Namespaces)
Language.Comment:                                 110, 110, 110
Language.DocComment:                              110, 110, 110
Language.BlockComment:                            110, 110, 110
Language.DefinedOut:                              80, 80, 80
Language.Variable:                                210, 210, 210
Language.MemberVariable:                          210, 210, 210
Language.Namespace:                               210, 210, 210
Language.Brace:                                   210, 210, 210
Language.Bracket:                                 210, 210, 210
Language.SquareBracket:                           210, 210, 210
Language.SemiColon:                               210, 210, 210
Language.Operator:                                210, 210, 210
Language.Comma:                                   210, 210, 210

# --- Tags & System Markers ---
Todo:                                             210, 150, 70
Fixme:                                            190, 110, 150
Note:                                             140, 190, 140
Hardcoded:                                        190, 110, 150
Important:                                        190, 110, 150
UI.SavedLine:                                     default
Editor.ErrorUnderline:                            190, 110, 150
Editor.WarningUnderline:                          210, 150, 70
Build.BuildError:                                 190, 110, 150
Build.BuildWarning:                               210, 150, 70